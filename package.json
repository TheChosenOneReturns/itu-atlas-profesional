{
  "name": "itu-atlas",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "start": "node serve.mjs",
    "dev": "node serve.mjs",
    "build": "npm run build:motion && npm run build:landing",
    "build:motion": "esbuild src/motion.js --bundle --minify --format=iife --target=es2020 --outfile=dist/motion.bundle.js",
    "build:landing": "esbuild src/landing.js --bundle --minify --format=iife --target=es2020 --outfile=dist/landing.bundle.js"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "motion": "^12.23.12"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
